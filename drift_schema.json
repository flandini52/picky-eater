        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"foods\" (\"id\" TEXT NOT NULL, \"person_id\" TEXT NOT NULL REFERENCES persons (id), \"name\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"current_level\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
