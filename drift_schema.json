        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" TEXT NOT NULL, \"person_id\" TEXT NOT NULL REFERENCES persons (id), \"food_id\" TEXT NOT NULL REFERENCES foods (id), \"date\" INTEGER NOT NULL, \"target_level\" INTEGER NOT NULL, \"achieved_level\" INTEGER NULL, \"notes\" TEXT NULL, PRIMARY KEY (\"id\"));"
