      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"persons\" (\"id\" TEXT NOT NULL, \"family_id\" TEXT NOT NULL REFERENCES families (id), \"name\" TEXT NOT NULL, \"birth_date\" INTEGER NULL, \"avatar_color\" INTEGER NOT NULL DEFAULT 4294940672, PRIMARY KEY (\"id\"));"
